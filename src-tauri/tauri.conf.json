{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-docs/main/tooling/bundler/schema.json",
  "productName": "SparkSuite",
  "version": "1.2.0",
  "identifier": "com.sparksuite.app",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "title": "SparkSuite",
    "windows": [
      {
        "title": "SparkSuite",
        "width": 500,
        "height": 850,
        "minWidth": 400,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' file:; connect-src 'self' http://localhost:3456"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
