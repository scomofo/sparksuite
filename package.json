{
  "name": "sparksuite",
  "version": "1.2.3",
  "description": "Multi-instrument music learning suite",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scomofo/sparksuite.git"
  },
  "bugs": {
    "url": "https://github.com/scomofo/sparksuite/issues"
  },
  "homepage": "https://github.com/scomofo/sparksuite#readme",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:portable": "electron-builder --win portable",
    "smoke:desktop": "node scripts/desktop_packaged_smoke.js",
    "smoke:desktop:tauri": "node scripts/desktop_packaged_smoke.js --runtime tauri",
    "lint": "node scripts/check_ui_business_logic.js",
    "curriculum:generate": "node scripts/curriculum/generate_phase1_curriculum.js",
    "curriculum:validate": "node scripts/lint/validate-curriculum.js",
    "curriculum:check-novelty": "node scripts/lint/check-novelty-counts.js",
    "audio:generate-loop-metadata": "node scripts/audio/generate-loop-metadata.js",
    "performance:generate-chart-data": "node scripts/generate-chart-data.js",
    "handoff:phase-gate": "node scripts/lint/check-handoff-phase-gate.js",
    "check:ui-logic": "node scripts/check_ui_business_logic.js",
    "lint:content": "node scripts/check_content_contracts.js",
    "test:contracts": "node scripts/check_session_contracts.js && node scripts/check_instrument_contracts.js && node scripts/check_action_registry.js && node scripts/check_ui_business_logic.js",
    "verify": "node scripts/verify.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:mobile": "node -e \"const fs=require('fs');const p=require('path');function cp(s,d){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>{const sp=p.join(s,f),dp=p.join(d,f);fs.statSync(sp).isDirectory()?cp(sp,dp):fs.copyFileSync(sp,dp)});}['index.html','styles.css','icon.png'].forEach(f=>fs.copyFileSync(f,p.join('www',f)));cp('js',p.join('www','js'));console.log('Assets copied to www/')\"",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "test:av": "node ci/smoke-av.mjs",
    "test:e2e": "node tests/e2e/session_happy_path.test.js && node tests/e2e/instrument_modularity.test.js",
    "test:browser": "node tests/browser_clickthrough_smoke.js",
    "test": "npm run performance:generate-chart-data --silent && node tests/run-tests.js && npm run test:e2e && node scripts/check_ui_business_logic.js"
  },
  "author": "SparkSuite",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2",
    "execa": "^9.6.0",
    "ffprobe-static": "^3.1.0",
    "music-metadata": "^11.8.3",
    "pdfjs-dist": "^5.1.91"
  },
  "build": {
    "appId": "com.sparksuite.app",
    "productName": "SparkSuite",
    "publish": {
      "provider": "github",
      "owner": "scomofo",
      "repo": "sparksuite",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "styles.css",
      "spark-showroom.css",
      "spark-visual.css",
      "spark-visual-v2.css",
      "js/**/*",
      "sounds/**/*",
      "assets/audio/**/*",
      "data/**/*",
      "content/**/*",
      "sparkgame/**/*",
      "desktop/**/*",
      "resources/instruments/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*",
          "!instruments/**"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
